<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.DemoTest" parent="@style/ActivityMain">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>



    <style name="Theme.DemoTest.LocaleSkin" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/locale_skin_background</item>
        <item name="android:colorBackground">@color/locale_skin_background</item>
        <item name="android:textColorPrimary">@color/locale_skin_foreground</item>
        <item name="colorAccent">@color/locale_skin_accent</item>
    </style>
</resources>